<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal Frost: Soft neutral slate gradients, frosty glass refraction, and icy crystalline aesthetics -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="1080dp"
    android:height="2400dp"
    android:viewportWidth="1080"
    android:viewportHeight="2400">

    <!-- Neutral Slate/Graphite Gradient -->
    <path
        android:pathData="M0,0h1080v2400h-1080z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="1080"
                android:endY="2400"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF0F172A" />
                <item android:offset="0.35" android:color="#FF1E293B" />
                <item android:offset="0.75" android:color="#FF182234" />
                <item android:offset="1.0" android:color="#FF0A0F1D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Frosted Glass Wave 1 -->
    <path
        android:pathData="M-100,500 C200,350 450,700 800,500 C1000,380 1200,600 1200,1100 C950,1300 650,1050 350,1250 C100,1400 -100,1200 -100,500 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="100"
                android:startY="350"
                android:endX="1000"
                android:endY="1250"
                android:type="linear">
                <item android:offset="0.0" android:color="#00334155" />
                <item android:offset="0.5" android:color="#3394A3B8" />
                <item android:offset="0.8" android:color="#44CBD5E1" />
                <item android:offset="1.0" android:color="#001E293B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Frosted Glass Wave 2 -->
    <path
        android:pathData="M-50,1300 C250,1150 550,1550 900,1300 C1150,1150 1250,1450 1250,2000 C950,2250 550,1950 200,2150 C-50,2250 -50,1850 -50,1300 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="200"
                android:startY="1150"
                android:endX="1000"
                android:endY="2150"
                android:type="linear">
                <item android:offset="0.0" android:color="#00475569" />
                <item android:offset="0.5" android:color="#3364748B" />
                <item android:offset="0.8" android:color="#2594A3B8" />
                <item android:offset="1.0" android:color="#000F172A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Frost Crystal Facet Lines -->
    <path
        android:pathData="M150,450 L380,300 L650,550 L420,700 Z M520,1250 L850,1050 L1020,1350 L690,1550 Z"
        android:strokeWidth="1"
        android:strokeColor="#25CBD5E1" />
</vector>
