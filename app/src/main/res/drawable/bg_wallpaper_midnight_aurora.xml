            <gradient
                android:startX="100"
                android:startY="1400"
                android:endX="1000"
                android:endY="2200"
                android:type="linear">
                <item android:offset="0.0" android:color="#00164E63" />
                <item android:offset="0.5" android:color="#5506B6D4" />
                <item android:offset="0.8" android:color="#446366F1" />
