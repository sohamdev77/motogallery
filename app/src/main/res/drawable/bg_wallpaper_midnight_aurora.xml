    <!-- Star Highlights -->
    <path
        android:pathData="M240,220 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 M780,180 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 M520,380 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 M150,750 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 M920,680 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 M340,1320 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 M850,1850 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 M180,2100 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0"
